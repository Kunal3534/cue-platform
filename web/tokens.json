{
  "$schema": "https://schemas.cue.app/design-tokens/v1",
  "color": {
    "signal": {
      "day":        { "value": "#F4CE45", "description": "Exterior Day" },
      "day-int":    { "value": "#F6F1E4", "description": "Interior Day" },
      "night":      { "value": "#23345C", "description": "Exterior Night" },
      "night-int":  { "value": "#5B7759", "description": "Interior Night" },
      "dusk":       { "value": "#D29245", "description": "Dusk / golden hour" }
    },
    "ink": {
      "slate":      { "value": "#141418", "description": "Ink, headers, primary text" },
      "slate-70":   { "value": "#141418B3" },
      "slate-50":   { "value": "#14141880" },
      "slate-30":   { "value": "#1414184D" }
    },
    "surface": {
      "chalk":      { "value": "#F4EEDF", "description": "Primary surface — never #fff" },
      "paper":      { "value": "#FAF5E6", "description": "Slightly brighter surface for cards" },
      "hair":       { "value": "#D0C9BA", "description": "Hairline rules" },
      "hair-soft":  { "value": "#E5DFD0" }
    },
    "accent": {
      "cue-red":    { "value": "#BC2F2A", "description": "Wordmark 'CUE', errors, edits — used sparingly" },
      "cue-red-10": { "value": "#BC2F2A1A" }
    },
    "dood": {
      "work":       { "value": "#BC2F2A", "description": "W cells in cast DOOD" },
      "hold":       { "value": "#F4CE45", "description": "H cells" },
      "travel":     { "value": "#D29245", "description": "T cells" },
      "off":        { "value": "transparent",  "description": "Off days" }
    }
  },
  "font": {
    "serif": { "value": "IBM Plex Serif, Georgia, serif", "role": "Body, headings" },
    "mono":  { "value": "IBM Plex Mono, SFMono-Regular, Menlo, monospace", "role": "Meta, data, tabular" },
    "strip": { "value": "Big Shoulders Display, Impact, sans-serif", "role": "Display numerals, stripboard" },
    "erica": { "value": "Erica One, serif", "role": "Poster-weight accents" },
    "ui":    { "value": "Inter, system-ui, sans-serif", "role": "UI chrome (fallback)" }
  },
  "type": {
    "display":      { "family": "serif", "weight": 400, "size": 64, "lineHeight": 1.02, "letterSpacing": "-0.02em" },
    "display-sm":   { "family": "serif", "weight": 400, "size": 44, "lineHeight": 1.05, "letterSpacing": "-0.02em" },
    "heading-lg":   { "family": "serif", "weight": 400, "size": 32, "lineHeight": 1.2 },
    "heading":      { "family": "serif", "weight": 400, "size": 24, "lineHeight": 1.25 },
    "subheading":   { "family": "serif", "weight": 400, "size": 18, "lineHeight": 1.4 },
    "body":         { "family": "serif", "weight": 400, "size": 16, "lineHeight": 1.55 },
    "voice":        { "family": "serif", "weight": 400, "size": 19, "lineHeight": 1.55, "description": "Hero voice paragraphs" },
    "meta":         { "family": "mono",  "weight": 500, "size": 11, "letterSpacing": "0.12em", "textTransform": "uppercase" },
    "meta-red":     { "family": "mono",  "weight": 500, "size": 11, "letterSpacing": "0.12em", "textTransform": "uppercase", "color": "accent.cue-red" },
    "data":         { "family": "mono",  "weight": 400, "size": 13, "lineHeight": 1.45, "fontVariantNumeric": "tabular-nums" },
    "strip-num":    { "family": "strip", "weight": 800, "size": 28, "letterSpacing": "-0.01em" }
  },
  "space": {
    "0":   { "value": 0 },
    "1":   { "value": 4 },
    "2":   { "value": 8 },
    "3":   { "value": 12 },
    "4":   { "value": 16 },
    "5":   { "value": 20 },
    "6":   { "value": 24 },
    "8":   { "value": 32 },
    "10":  { "value": 40 },
    "12":  { "value": 48 },
    "14":  { "value": 56 },
    "16":  { "value": 64 },
    "20":  { "value": 80 },
    "24":  { "value": 96 }
  },
  "layout": {
    "page-max":  { "value": 1280, "unit": "px" },
    "page-pad":  { "value": 56,   "unit": "px" },
    "nav-height":{ "value": 56,   "unit": "px" }
  },
  "radius": {
    "none":  { "value": 0 },
    "sm":    { "value": 2 },
    "md":    { "value": 4 },
    "lg":    { "value": 8 },
    "pill":  { "value": 999 }
  },
  "border": {
    "hair":      { "value": "1px solid #D0C9BA" },
    "hair-soft": { "value": "1px solid #E5DFD0" }
  },
  "shadow": {
    "none":  { "value": "none" },
    "card":  { "value": "0 1px 0 rgba(20,20,24,0.04), 0 1px 3px rgba(20,20,24,0.06)" },
    "modal": { "value": "0 20px 60px rgba(20,20,24,0.18)" }
  },
  "transition": {
    "fast":  { "value": "120ms ease-out" },
    "base":  { "value": "200ms ease-out" },
    "slow":  { "value": "360ms cubic-bezier(0.2, 0.0, 0, 1)" }
  },
  "brand": {
    "logo":          { "src": "/cue-mark.svg", "minHeight": 32, "defaultHeight": 56 },
    "wordmarkColor": { "value": "ink.slate" },
    "neverUseWhite": true
  }
}
