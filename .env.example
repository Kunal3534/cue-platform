# Copy to .env and edit for your environment
# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://cue:cue@db:5432/cue
ASYNC_DATABASE_URL=postgresql+asyncpg://cue:cue@db:5432/cue
SECRET_KEY=change-me-in-prod
FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Dev-mode auto-login (so you don't need a magic link in local dev).
# Set this to the email you want to be "signed in as" automatically.
DEV_AUTO_LOGIN_EMAIL=you@studio.in

# Production magic-link auth (Resend)
# RESEND_API_KEY=re_...
# MAIL_FROM=no-reply@cue.app

# ---------------------------------------------------------------------------
# Redis (SSE pub/sub + Arq worker queue)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Object storage (S3 / MinIO — PDFs, xlsx exports, zip bundles)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://minio:9000
S3_BUCKET=cue
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Chat agent (Anthropic)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
